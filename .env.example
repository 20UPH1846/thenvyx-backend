# ─────────────────────────────────────────────
# Thenvyx Tech — Environment Variables
# ─────────────────────────────────────────────
# 1. இந்த file-ஐ ".env" என rename பண்ணுங்க
# 2. உங்க Gmail details fill பண்ணுங்க
# 3. .gitignore-ல .env add பண்ணுங்க (IMPORTANT!)
# ─────────────────────────────────────────────

# உங்க Gmail address (form submissions இங்க வரும்)
GMAIL_USER=teamthenvyx@gmail.com

# Gmail App Password (NOT உங்க regular password!)
# எப்படி பண்றது: README.md-ல பாருங்க
GMAIL_APP_PASS=your_app_password_here

# Server port (default: 3000)
PORT=3000
